generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String?
  role      String   @default("rider")
  createdAt DateTime @default(now())
  rides     Ride[]   @relation("userRides")
}

model Captain {
  id         String   @id @default(uuid())
  name       String
  phone      String   @unique
  vehicleNo  String?
  kycStatus  String   @default("pending")
  online     Boolean  @default(false)
  createdAt  DateTime @default(now())
  rides      Ride[]   @relation("captainRides")
}

model Ride {
  id          String   @id @default(uuid())
  user        User     @relation("userRides", fields: [userId], references: [id])
  userId      String
  captain     Captain? @relation("captainRides", fields: [captainId], references: [id])
  captainId   String?
  pickup      String
  dropoff     String
  distanceKm  Float?
  fare        Float?
  status      String   @default("requested") // requested, accepted, ongoing, completed, cancelled
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
}
